# Data: "sample" serves the design's fictional data so every screen works without chain or DB; "live" reads NEAR and Postgres.
DATA_SOURCE=sample

# NEAR
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_CUT_CONTRACT=thecut.testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Keeper: a function-call access key on a funded account, allowed to call only run_cut on the contract.
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=
# Test mode: a funded testnet account that creates and funds judge accounts.
FAUCET_ACCOUNT_ID=
FAUCET_PRIVATE_KEY=

# Database (docker compose: pnpm db:up)
DATABASE_URL=postgres://cut:cut@localhost:54330/cut_near

# Sessions (NEP-413 sign-in) and cron
SESSION_SECRET=
CRON_SECRET=

# NEAR AI Cloud (https://cloud.near.ai). Pick a "Private" model from GET https://cloud-api.near.ai/v1/models so every line is signed inside a TEE.
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
