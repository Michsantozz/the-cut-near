# Data: "sample" serves the design's fictional data so every screen works without chain or DB; "live" reads NEAR and Postgres.
DATA_SOURCE=sample

# NEAR
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_CUT_CONTRACT=thecut.testnet
# Preferred RPC endpoint (optional). The network's public endpoints from docs.near.org/api/rpc/providers are the fallbacks.
NEAR_RPC_URL=https://test.rpc.fastnear.com
# Indexer event source: FastNEAR Transactions API (optional; defaults to https://tx.test.fastnear.com or https://tx.main.fastnear.com).
NEAR_TX_API_URL=
# Keeper: a function-call access key on a funded account, allowed to call only run_cut on the contract.
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=
# The keeper refuses to sign on mainnet unless a human sets this to true.
KEEPER_ALLOW_MAINNET=false
# Test mode: a funded testnet account that creates and funds judge accounts.
FAUCET_ACCOUNT_ID=
FAUCET_PRIVATE_KEY=

# Database (docker compose: pnpm db:up)
DATABASE_URL=postgres://cut:cut@localhost:54330/cut_near

# Sessions (NEP-413 sign-in): 32+ random characters, e.g. `openssl rand -base64 48`. Required when DATA_SOURCE=live.
SESSION_SECRET=
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET` (16+ characters). Cron endpoints refuse every call without it.
CRON_SECRET=

# NEAR AI Cloud (https://cloud.near.ai). Only "Private" models (`"owned_by": "nearai"` in GET https://cloud-api.near.ai/v1/models)
# run inside a TEE and sign their replies; anything else is refused. Empty values use the defaults:
#   NEAR_AI_MODEL=z-ai/glm-5.3-flash            NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
#   NEAR_AI_TIMEOUT_MS=45000                    NEAR_AI_MAX_RETRIES=3
#   NEAR_AI_SIGNING_ALGO=ecdsa (or ed25519)     NEAR_AI_REASONING_EFFORT=low (none, medium, high)
#   NEAR_AI_HARDWARE_CHECKS=on: verify the Intel TDX quote (Phala PCCS) and the GPU evidence (NVIDIA NRAS)
NEAR_AI_API_KEY=
NEAR_AI_MODEL=
NEAR_AI_BASE_URL=
NEAR_AI_TIMEOUT_MS=
NEAR_AI_MAX_RETRIES=
NEAR_AI_SIGNING_ALGO=
NEAR_AI_REASONING_EFFORT=
NEAR_AI_HARDWARE_CHECKS=
