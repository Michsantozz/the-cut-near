{
  "name": "the-cut-near",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "db:up": "docker compose up -d db",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "contracts:build": "cd contracts && cargo near build non-reproducible-wasm --manifest-path thecut/Cargo.toml && cargo near build non-reproducible-wasm --manifest-path robot/Cargo.toml",
    "contracts:test": "cd contracts && cargo test --workspace",
    "sim": "python3 scripts/sim.py"
  },
  "packageManager": "pnpm@12.18.0",
  "dependencies": {
    "@hot-labs/near-connect": "^0.12.0",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.17",
    "lucide-react": "^1.72.0",
    "near-api-js": "^7.5.3",
    "near-connect-hooks": "^1.1.6",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "openai": "^7.56.0",
    "postgres": "^4.1.1",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.10",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "msw": "^3.0.5",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
